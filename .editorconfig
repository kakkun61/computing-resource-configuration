[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
tab_width = 2
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
tab_width = 4

[.gitconfig, .gitmodules]
indent_style = tab

[Makefile*]
indent_style = tab

[home/aqua-skk/kana-rule.conf]
charset = euc-jp
trim_trailing_whitespace = false

[windows/*.xml]
charset = utf-16le
insert_final_newline = false
