SHELL := pwsh.exe
.SHELLFLAGS = -NoProfile -Command

.PHONY: all
all: cloud-native-pg.yaml immich.yaml nfs-subdir-external-provisioner.yaml pdfding.yaml

cloud-native-pg.yaml: cloud-native-pg.template.yaml cloud-native-pg.helm-values.yaml
	Set-Content -Path '$@' -Value '# This file is generated. Do not edit manually.';
	Get-Content -Path 'cloud-native-pg.template.yaml' | Add-Content -Path '$@';
	Get-Content -Path 'cloud-native-pg.helm-values.yaml' | ForEach-Object { '    ' + $$_ } | Add-Content -Path '$@';
	Get-Content -Path '$@' | ForEach-Object { if ($$_ -match '^\s+$$') { '' } else { $$_ } } | Set-Content -Path '$@.tmp';
	Move-Item -Force -Path '$@.tmp' -Destination '$@';
	((Get-Content '$@') -join "`n") + "`n" | Set-Content -NoNewline '$@.tmp';
	Move-Item -Force -Path '$@.tmp' -Destination '$@';

